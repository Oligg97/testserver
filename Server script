import json
import sqlite3
from pathlib import Path

"""Variabler"""
results_file = Path(__file__).with_name("results.json") # path til JSON-filen med resultaterne
results = json.loads(results_file.read_text(encoding="utf-8")) # Læs JSON-filen og konverter den til en Python-liste af ordbøger
database_file = Path(__file__).with_name("sensordata.db") # path til SQLite-databasen


def insert_item(connection, item):
    """Indsætter en enkelt post i sensor_data-tabellen i SQLite-databasen."""
    connection.execute(
        """
        INSERT INTO sensor_data (nameid, sensor, input, result, timestamp)
        VALUES (?, ?, ?, ?, ?)
        """,
        (
            item["id"],
            item["sensor"],
            json.dumps(item["inputs"]),
            item["result"],
            item["timestamp"],
        ),
    )


with sqlite3.connect(database_file) as connection:
    # Opret tabellen første gang; SQLite gemmer JSON-input som TEXT.
    connection.execute("""
        CREATE TABLE IF NOT EXISTS sensor_data (
            uid INTEGER PRIMARY KEY AUTOINCREMENT,
            nameid TEXT,
            sensor TEXT,
            input TEXT,
            result BOOLEAN,
            timestamp TEXT
        )
    """)

    columns = {
        column[1]
        for column in connection.execute("PRAGMA table_info(sensor_data)")
    }
    if "timestamp" not in columns:
        connection.execute("ALTER TABLE sensor_data ADD COLUMN timestamp TEXT")

    for result in results:
        print(f"{result['id']} ({result['sensor']}): {result['result']}")
        insert_item(connection, result)

print(f"{len(results)} JSON-poster indsat i {database_file.name}")
